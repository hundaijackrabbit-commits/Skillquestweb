# Supabase (required for accounts, newsletter, tracking, and Growth Console)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public production origin used in guide email download links.
NEXT_PUBLIC_SITE_URL=https://modernskilllab.space

# Optional: server-only privileged account role controls in /admin.
# NEVER expose this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: comma-separated emergency/bootstrap admins. This fallback is only
# honored when SUPABASE_SERVICE_ROLE_KEY is also configured.
ADMIN_EMAILS=

# Resend (required for Career & Life Map email delivery)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Modern Skill Lab <guide@mail.modernskilllab.space>
# Optional address for replies to transactional guide emails.
RESEND_REPLY_TO_EMAIL=

# Optional: advertising stays off unless placements are also enabled in /admin.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Cartesia Line voice agent (server-only)
# Keep the API key private; the browser receives only a short-lived access token.
CARTESIA_API_KEY=
CARTESIA_AGENT_ID=
CARTESIA_VERSION=2026-08-14
# Bearer token used by the Cartesia navigation webhook. Keep server-only.
CARTESIA_NAVIGATION_WEBHOOK_TOKEN=
# Optional override; normally leave this unchanged.
CARTESIA_WEBSOCKET_BASE_URL=wss://agents.cartesia.ai
